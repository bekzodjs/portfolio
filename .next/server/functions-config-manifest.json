{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!api|_next|.*\\..*).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!api|_next|.*\\..*).*)"
        }
      ]
    },
    "/api/admin/login": {},
    "/api/admin/logout": {},
    "/api/admin/profile": {},
    "/api/admin/projects": {},
    "/api/admin/projects/[slug]": {},
    "/api/admin/settings": {},
    "/api/admin/upload": {}
  }
}