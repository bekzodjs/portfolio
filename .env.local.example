# Bu faylni ".env.local" deb nusxalang va qiymatlarni to'ldiring.

# Admin login (foydalanuvchi nomi):
ADMIN_USERNAME=bekzodtoxtamuratov

# Parol — o'zingiz tanlang, kuchli bo'lsin:
ADMIN_PASSWORD=ozingiz-tanlagan-parol

# Sessiya imzosi uchun uzun tasodifiy maxfiy kalit:
ADMIN_SECRET=uzun-tasodifiy-maxfiy-kalit
